# Copia este archivo como .env, .env.development o .env.production y cambia los valores!
# 🔹 Entorno LOCAL (tu PC) - descomenta para trabajar en tu PC
# VITE_API_URL=http://localhost:5000/api
# 🔸 Entorno PRODUCCIÓN (Railway) - descomenta para desplegar
VITE_API_URL=https://tu-backend.up.railway.app/api

# Cloudinary (subida de imágenes de productos)
VITE_CLOUDINARY_CLOUD_NAME=tu_cloud_name
VITE_CLOUDINARY_UPLOAD_PRESET=tu_upload_preset
