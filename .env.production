# Entorno de Producción (Railway)
# Reemplaza la URL por el dominio público real de tu backend en Railway.
VITE_API_URL=https://tu-backend.up.railway.app/api
# VITE_API_URL=http://localhost:5000/api

# Cloudinary (subida de imágenes de productos). En Railway, defínelas también
# en Variables del servicio frontend con tus valores reales.
VITE_CLOUDINARY_CLOUD_NAME=tu_cloud_name
VITE_CLOUDINARY_UPLOAD_PRESET=tu_upload_preset
